{
  "output_dir": "assets/polarity_dial_paper",
  "device": "auto",
  "data": {
    "seed": 2,
    "num_train": 200000,
    "num_val": 20000,
    "num_test": 20000,
    "input_dim": 512,
    "num_features": 128,
    "activation_prob": 0.05,
    "positive_sign_prob": 0.7,
    "lognormal_mu": 0.0,
    "lognormal_sigma": 0.5,
    "exponential_lambda": 1.5,
    "noise_std": 0.1
  },
  "models": [
    {
      "name": "relu_sae",
      "sae_class": "SAE",
      "sign_aware": false,
      "single_activation_offset": false,
      "reset_activation_offsets_on_resample": false,
      "d_hidden": 128,
      "sparsity_coeff": 0.001,
      "learning_rate": 0.0001,
      "num_epochs": 50,
      "batch_size": 1024,
      "adam_betas": [
        0.9,
        0.999
      ]
    },
    {
      "name": "relu_sae_2x",
      "sae_class": "SAE",
      "sign_aware": false,
      "single_activation_offset": false,
      "reset_activation_offsets_on_resample": false,
      "d_hidden": 256,
      "sparsity_coeff": 0.001,
      "learning_rate": 0.0001,
      "num_epochs": 50,
      "batch_size": 1024,
      "adam_betas": [
        0.9,
        0.999
      ]
    },
    {
      "name": "gated_sae",
      "sae_class": "GatedSAE",
      "sign_aware": false,
      "single_activation_offset": false,
      "reset_activation_offsets_on_resample": false,
      "d_hidden": 128,
      "sparsity_coeff": 0.001,
      "learning_rate": 0.0001,
      "num_epochs": 50,
      "batch_size": 1024,
      "adam_betas": [
        0.9,
        0.999
      ]
    },
    {
      "name": "gated_sae_2x",
      "sae_class": "GatedSAE",
      "sign_aware": false,
      "single_activation_offset": false,
      "reset_activation_offsets_on_resample": false,
      "d_hidden": 256,
      "sparsity_coeff": 0.001,
      "learning_rate": 0.0001,
      "num_epochs": 50,
      "batch_size": 1024,
      "adam_betas": [
        0.9,
        0.999
      ]
    },
    {
      "name": "signed_soft_threshold",
      "sae_class": "SignedSoftThresholdSAE",
      "sign_aware": false,
      "single_activation_offset": false,
      "reset_activation_offsets_on_resample": false,
      "d_hidden": 128,
      "sparsity_coeff": 0.001,
      "learning_rate": 0.0001,
      "num_epochs": 50,
      "batch_size": 1024,
      "adam_betas": [
        0.9,
        0.999
      ]
    },
    {
      "name": "sign_aware_gated_sae",
      "sae_class": "GatedSAE",
      "sign_aware": true,
      "single_activation_offset": false,
      "reset_activation_offsets_on_resample": true,
      "d_hidden": 128,
      "sparsity_coeff": 0.001,
      "learning_rate": 0.0001,
      "num_epochs": 50,
      "batch_size": 1024,
      "adam_betas": [
        0.9,
        0.999
      ]
    }
  ],
  "evaluation": {
    "alignment_mode": "axis_abs_cosine",
    "axis_aggregation_for_nonnegative": true,
    "normalize_decoder_for_eval": true,
    "min_regime_samples": 50,
    "max_points_per_regime_scatter": 5000
  }
}
